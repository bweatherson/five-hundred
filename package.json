{
  "name": "five-hundred",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rules engine and strategy test bench for the card game 500",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "match": "tsx src/cli.ts",
    "sweep": "tsx src/sweep.ts",
    "build-winprob": "tsx src/build-winprob.ts",
    "web": "vite web",
    "web:build": "vite build web",
    "web:artifact": "vite build web --mode artifact && node web/artifact.mjs"
  },
  "devDependencies": {
    "@fontsource/fraunces": "^5.1.0",
    "@fontsource/inter": "^5.1.0",
    "@types/node": "^18.19.64",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "peerjs": "^1.5.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
